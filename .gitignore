# Run outputs: every run's output folder at any depth (runs/<name>/output/ and
# runs/<try>/<metal>/output/): tables, figures, caches, the PDF report, and the switch-off
# what-ifs (mechanism_switch_off*.csv, cache_diagnostics/). Also output folders with another
# name (output_*), and logs.
runs/**/output/
runs/**/output_*/
runs/**/mechanism_switch_off*.csv
runs/**/cache*/
runs/**/report/
*.log
*.zip


# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/

# Notebooks
.ipynb_checkpoints/

# runs
runs/ni_first_try/
# RMG files the package does not read: species pictures and the edge seed (393 MB for the
# try_* runs, one file over GitHub's 100 MB limit). They stay on disk (and in the zips).
runs/**/species/
runs/**/seed/seed_edge/

# OS / editors
.DS_Store
.vscode/
.playwright-mcp/
